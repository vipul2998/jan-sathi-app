# ============= SERVER CONFIGURATION =============
PORT=5001
NODE_ENV=development

# ============= DATABASE =============
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/jansathi?retryWrites=true&w=majority

# ============= AI ASSISTANT (Claude) =============
ANTHROPIC_API_KEY=sk-ant-replace_with_your_actual_anthropic_key
ANTHROPIC_MODEL=claude-sonnet-4-6

# ============= ADMIN ACCESS =============
ADMIN_PIN=1234

# ============= EMAIL SERVICE (Resend) =============
RESEND_API_KEY=re_ixbxpLM5_paste_your_full_resend_token_here
EMAIL_FROM=noreply@jansathi.local

# ============= SMS SERVICE (Twilio) =============
# Optional - Leave empty for demo mode (OTP will be logged to console)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Use the WhatsApp sender approved for your Twilio/Meta Business account.
TWILIO_OTP_CHANNEL=whatsapp
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_PHONE_NUMBER=+1234567890

# ============= PAYMENT GATEWAY (Razorpay) =============
# Demo Mode: If empty, payment API will return mock responses
# Test Mode: Use test keys from Razorpay dashboard
# Production: Use live keys (NEVER commit these to git)
RAZORPAY_KEY_ID=rzp_test_your_test_key_id
RAZORPAY_KEY_SECRET=razorpay_test_key_secret_here

# ============= SUBSCRIPTION SERVICE (KaroSub) =============
KAROSUB_API_KEY=replace_with_your_karosub_secret_key
KAROSUB_BASE_URL=https://api.karosub.example.com
KAROSUB_MODE=sandbox
KAROSUB_CURRENCY=INR

# ============= CORS & ALLOWED ORIGINS =============
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# ============= MSG91 OTP =============
